# Added by Cargo
# Contains all compiled binaries, build artifacts, and dependency artifacts
/target

# Backup files generated by rustfmt when formatting code
**/*.rs.bk

# MSVC Windows build debugging files (Program Database)
*.pdb

# Mutation testing data generated by cargo-mutants
**/mutants.out*/

# Internal compiler error (ICE) stack dump files generated by rustc
rustc-ice-*.txt
